{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email del suscriptor"
    },
    "name": {
      "type": "string",
      "description": "Nombre del suscriptor"
    },
    "source": {
      "type": "string",
      "description": "De d\u00f3nde se suscribi\u00f3 (footer, popup, etc)"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}